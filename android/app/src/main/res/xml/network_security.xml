<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 本地服务器(127.0.0.1)与局域网 ws:// 中继需要明文流量 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
